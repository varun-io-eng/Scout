{
  "manifest_version": 3,
  "name": "Scout",
  "version": "1.7.6",
  "description": "Puppeteer field match + LLM ICP score → Ready",
  "permissions": ["activeTab", "storage", "sidePanel", "scripting", "tabs", "cookies"],
  "host_permissions": [
    "http://localhost:3847/*",
    "http://localhost:6039/*",
    "http://localhost:3000/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["dock.html", "panel.css", "panel-app.js", "icons/linkedin.svg"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js", "dock-host.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.linkedin.com/*", "https://linkedin.com/*"],
      "js": ["linkedin-assist.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://localhost:3000/*",
        "https://*.zequinia.com/*",
        "https://zequinia.com/*"
      ],
      "js": ["aura-operator.js", "aura-assist.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
