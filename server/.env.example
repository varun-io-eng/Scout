PORT=3847

# Groq (recommended — free tier, fast)
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (optional — used only if GROQ_API_KEY is not set)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

DATABASE_PATH=./data/scout.json

# Default matches production Aura (.env NEXT_PUBLIC_DATAHUB_BASE_URL)
DATAHUB_BASE_URL=https://app.zequinia.com/zequinia-datahub

# Minimum ICP fit score (0–10) for Ready after Puppeteer verify. Below / fail → delete from campaign.
LEAD_FIT_READY_THRESHOLD=8

# Puppeteer — verifies Aura Edit fields vs LinkedIn + company website
# Persistent profile: log into LinkedIn once in the opened Chrome window
PUPPETEER_USER_DATA_DIR=./data/puppeteer-profile
# false = visible browser (use for first LinkedIn login); true = headless after session saved
PUPPETEER_HEADLESS=false

# ─── Apollo Company Enrichment (PRIMARY Enrichment Method) ───────────────
# Uses Apollo.io's organizations APIs for company enrichment (compliant, reliable)
# This is the PRIMARY enrichment method, avoiding LinkedIn scraping entirely
# Flow: Aura CRM → Apollo organizations/search → organizations/enrich → Update CRM
#
# 1. Sign up at https://apollo.io (free tier available)
# 2. Get API key from: Settings → API → API Key
# 3. Paste below:
APOLLO_API_KEY=your-apollo-api-key-here
#
# Company fields enriched:
#   company_name, company_employee_size, company_revenue_size, company_industry,
#   company_website, company_city, company_state, company_country
#
# Enrichment metadata stored:
#   company_enriched_at, company_last_verified_at, company_enrichment_source = "apollo"
#
# Staleness check: Companies enriched within 90 days are skipped to conserve credits
